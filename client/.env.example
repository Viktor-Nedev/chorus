# ─────────────────────────────────────────────────────────────────────────────
# CHORUS client environment
# Copy to `client/.env` (local) and set the same values in Vercel → Settings →
# Environment Variables (then REDEPLOY — Vite inlines VITE_* at build time).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — needed so auth (and Social/data) work from ANY device on the hosted
# site. Get the "anon public" key from Dashboard → Project Settings → API.
# Empty key = the app falls back to the local Express server (localhost:3001),
# which only works on the machine running `npm run dev` in /server — NOT from a
# phone or another laptop, and NOT on Vercel.
VITE_SUPABASE_URL=https://ggeehtsacqbagmqwsuml.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: URL of a publicly-hosted CHORUS Node server, for the features that
# still need it (Collective realtime, poems, WebForge). Defaults to
# http://localhost:3001 when unset. Leave empty if you rely only on Supabase.
VITE_SERVER_URL=
